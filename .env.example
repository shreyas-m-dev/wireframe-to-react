# Copy to .env and fill in. Never commit .env. See docs/ENVIRONMENT_VARIABLES.md.

# --- Supabase (Auth + Postgres) ------------------------------------------------
# Dashboard → Project Settings → API / Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for legacy projects still on the shared JWT secret (HS256). Leave unset
# for projects using asymmetric JWT signing keys (verified via JWKS).
# SUPABASE_JWT_SECRET=

# Dashboard → Connect → Session pooler (IPv4). Use the `postgres` user.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# verify (production default; needs DATABASE_SSL_CA) | require (dev default) | disable
DATABASE_SSL=require
# Dashboard → Database → Settings → SSL → Download certificate
# DATABASE_SSL_CA=./supabase-ca.crt

# Browser-side (bundled into the frontend; both values are public by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only when the frontend is hosted on a different origin than the API:
# VITE_API_BASE=https://api.example.com

# --- API server ----------------------------------------------------------------
PORT=3000
# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (e.g. 1 behind a load balancer)
TRUST_PROXY=false
# Supabase user UUIDs allowed to use /api/vision/* diagnostics
# ADMIN_USER_IDS=
# Where uploaded wireframes are stored (relative to the repo root)
DATA_DIR=data
# Serve the built SPA from the API (single-container deployments)
# FRONTEND_DIST=frontend/dist

# --- Limits ----------------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
MAX_ACTIVE_JOBS_PER_USER=2
JOBS_PER_HOUR_PER_USER=30
PIPELINE_STAGE_TIMEOUT_MS=180000

# --- Pipeline (passed to the Python worker) --------------------------------------
# PYTHON_BIN=C:\path\to\.venv\Scripts\python.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
GEN_MODE=template
RAG_BACKEND=faiss
VECTOR_BACKEND=sqlite_faiss
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K_PAGE=3
RAG_TOP_K_SECTION=3
RAG_TOP_K_COMPONENT=4
RAG_MIN_SCORE=0.35
RAG_REBUILD_INDEX=false

# Optional vision analysis. Disabled by default: when enabled, uploaded
# wireframes are sent to the configured provider. Keys stay server-side.
VISION_ENABLED=false
VISION_PROVIDER=disabled
# VISION_MODEL=
# VISION_API_KEY=
# GEMINI_API_KEY=
VISION_TIMEOUT_SECONDS=20
VISION_MAX_IMAGE_DIMENSION=1600
VISION_MAX_OUTPUT_TOKENS=4000
VISION_GEMINI_AUTO_SELECT_MODEL=false
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
