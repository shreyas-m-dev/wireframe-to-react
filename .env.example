PORT=3000
# PYTHON_BIN=C:\\path\\to\\python.exe
RAG_BACKEND=faiss
GEN_MODE=template
# Prepared semantic-catalog path (not used by the legacy 23-record catalog
# until an explicit ingest/reindex command is run).
VECTOR_BACKEND=sqlite_faiss
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K_PAGE=3
RAG_TOP_K_SECTION=3
RAG_TOP_K_COMPONENT=4
RAG_MIN_SCORE=0.35
RAG_REBUILD_INDEX=false
# GEMINI_API_KEY=
VISION_GEMINI_AUTO_SELECT_MODEL=false
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# VITE_API_BASE=http://localhost:3000
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional schema-only vision analysis. Disabled by default; no cloud call is
# made unless explicitly configured server-side. Never expose the key to Vite.
VISION_PROVIDER=disabled
VISION_ENABLED=false
# VISION_MODEL=
# VISION_API_KEY=
VISION_TIMEOUT_SECONDS=20
VISION_MAX_IMAGE_DIMENSION=1600
VISION_MAX_OUTPUT_TOKENS=4000
# Gemini may use VISION_API_KEY or this provider-specific key.
# GEMINI_API_KEY=
