{
  "name": "wireframe-to-react-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.js",
    "dev": "node --env-file-if-exists=../.env server.js",
    "dev:watch": "node --env-file-if-exists=../.env --watch-path=./src --watch-path=../services server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js up",
    "migrate:down": "node --env-file-if-exists=../.env src/db/migrate.js down",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
