{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wireframe vision layout response",
  "type": "object",
  "required": ["pageCategory", "nodes"],
  "properties": {"pageCategory": {"type": "string"}, "frame": {"type": "object"}, "styleHints": {"type": "object"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}},
  "$defs": {"bounds": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}, "node": {"type": "object", "required": ["id", "type", "role", "bounds"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "role": {"type": "string"}, "bounds": {"$ref": "#/$defs/bounds"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "layout": {"type": "object"}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}}}
}
